dot/mutt/headercache
dot/mutt/messagecache
dot/mutt/msg.asc

*.pid
*.log
.DS_Store
/nerd-fonts/

# Key material and certificates — never commit these
*.p12
*.pem
*.key
*.gpg

# Editor and tooling leftovers
*.bak
*.old
*.swp

# Large regenerable/downloadable vim spell dictionaries.
# The personal wordlist (spell/en.utf-8.add) is tracked on purpose.
dot/config/nvim/spell/*.sug
dot/config/nvim/spell/de.*

# Machine-local overrides, sourced if present (see dot/zshrc)
dot/zshrc.local
dot/zshenv.local
dot/gitconfig.local

# tmux plugins: `make tmux-plugins` clones tpm, which installs the rest of
# the @plugin list in dot/tmux.conf. None of it is vendored.
dot/tmux/plugins/*
