# macOS (Homebrew) counterpart to apt.list.
# Omitted vs. apt.list: sway, foot, wl-copy, xclip (Wayland/X11 only —
# macOS uses pbcopy/pbpaste, see dot/zshrc.Darwin).

# GNU userland — macOS ships BSD variants of these
coreutils
findutils
gnu-sed
gdb
# gobjdump, for the objdump alias in dot/zshrc.Darwin
binutils

# shell
zsh
autojump
fzf
fd
ripgrep
bat
most
jq
curl
git

# editors
neovim
vim

# terminal
tmux

# mail stack (mutt/mbsync/notmuch all read the configs in dot/)
neomutt
isync
notmuch
# html-to-text for neomutt's auto_view (see dot/mailcap)
w3m
pass
gnupg
# GUI passphrase prompt; the launchagent mail sync has no tty for a
# curses pinentry. See ~/.gnupg/gpg-agent.conf.
pinentry-mac
# lbdb has no formula; muttrc's query_command = lbdbq is a no-op without it

# build / dev
cmake
rbenv
ruby-build

# misc
syncthing
weechat
