ZSH_THEME="minimal"
plugins=(git zsh-syntax-highlighting pip)
# systemd plugin only makes sense on Linux
[[ "$OSTYPE" == linux* ]] && plugins+=(systemd)
# plugins+=(zsh-autosuggestions)
alias gdb="gdb --quiet"

# Debian ships bat as batcat
if (( $+commands[bat] )); then
  export MANPAGER="sh -c 'col -bx | bat --theme=base16 -p -lman'"
elif (( $+commands[batcat] )); then
  export MANPAGER="sh -c 'col -bx | batcat --theme=base16 -p -lman'"
fi

DISABLE_UPDATE_PROMPT=true
DISABLE_MAGIC_FUNCTIONS="true"
source $ZSH/oh-my-zsh.sh
#autoload -Uz compinit
# compinit -C -d ~/.zcompdump

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern)
ZSH_HIGHLIGHT_STYLES[comment]='fg=#585858,bold'
ZSH_HIGHLIGHT_STYLES[cursor]='bg=default'

HISTFILE=~/.histfile
HISTSIZE=10000
SAVEHIST=10000

export ESCDELAY=0
setopt autocd
bindkey -e

lazy_nvm() {
  unset -f node npm npx nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
}
for cmd in node npm npx nvm; do
  eval "$cmd() { lazy_nvm; $cmd \"\$@\"; }"
done

lazy_rbenv() {
  unset -f ruby gem rbenv
  if which rbenv > /dev/null; then eval "$(rbenv init - zsh)"; fi
}
for cmd in ruby gem rbenv; do
  eval "$cmd() { lazy_rbenv; $cmd \"\$@\"; }"
done

RPS1='%(?..%{$fg_no_bold[red]%}%? ↵%{$reset_color%})'

alias gst="git status --short"
alias mutt=neomutt

function pub_ip {
  dig -4 TXT +short o-o.myaddr.l.google.com @ns1.google.com | sed 's/"//g'
}

function hex () {
  echo -n 0x
  echo "obase=16; $1" | bc
}

function _latest () {
  echo "$1/$(ls -t $1 | head -n1)"
}

#unset ctrl-s
stty -ixon

export FZF_DEFAULT_COMMAND='fd --type f'
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export HOMEBREW_NO_ENV_HINTS=1

(( $+commands[pyenv] )) && eval "$(pyenv init -)"

function hex2chr {
  perl -pe 's/(..)/chr(hex($1))/ge'
}

function chr2hex {
  perl -pe 's/(.)/sprintf("%02x", ord($1))/ge'
}

function bin2hex() {
  python3 -c "print(hex(int('$1', 2)))"
}

function dec2bin() {
  python3 -c "print(bin($1))"
}

function osc7 {
    setopt localoptions extendedglob
    input=( ${(s::)PWD} )
    uri=${(j::)input/(#b)([^A-Za-z0-9_.\!~*\'\(\)-\/])/%${(l:2::0:)$(([##16]#match))}}
    print -n "\e]7;file://${HOSTNAME}${uri}\e\\"
}

autoload -Uz add-zsh-hook
add-zsh-hook -Uz chpwd osc7

export PS1='%n@%m %~ %# '

[ -r "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env" # ghcup-env
# opencode, Antigravity, LM Studio CLI
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"

# nvim plugins shell out to node and ruby, so load the lazy version managers
# before starting it rather than letting a plugin find a missing binary.
function vim {
  (( $+functions[lazy_nvm] )) && lazy_nvm
  (( $+functions[lazy_rbenv] )) && lazy_rbenv
  nvim "$@"
}

# Per-OS then per-machine overrides. Last so they win over anything above.
[ -r "$HOME/.zshrc.$(uname -s)" ] && . "$HOME/.zshrc.$(uname -s)"
[ -r "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
